# Optional. Leave empty for local development.
# wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=

# Optional site key shown to the browser when creating rooms.
# Also set wrangler.jsonc vars.TURNSTILE_SITE_KEY or override at deploy time.
TURNSTILE_SITE_KEY=

# Comma-separated extra allowed WebSocket Origins.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=https://liveclip.chius.cc
