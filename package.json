{
  "name": "liveclip",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Cloudflare-only real-time collaborative clipboard (Yjs + Durable Objects)",
  "homepage": "https://liveclip.chius.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chius-me/live-clip.git"
  },
  "bugs": {
    "url": "https://github.com/chius-me/live-clip/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lib0": "^0.2.119",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.2"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.1"
  }
}
